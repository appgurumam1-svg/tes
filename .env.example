# Nilai Neon di bawah ini diisi otomatis oleh `neon deploy` / `neon env pull`.
# Jangan commit nilai asli.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/db?sslmode=require
NEON_AUTH_BASE_URL=https://<auth-endpoint>/neondb/auth
NEON_AUTH_JWKS_URL=https://<auth-endpoint>/neondb/auth/.well-known/jwks.json
NEON_BRANCH=production
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=https://<branch>.storage.<cell>.<region>.aws.neon.tech
AWS_REGION=<region>

# Frontend (Vite) — publik, ikut ter-bundle saat build.
VITE_API_URL=https://<branch>-api.compute.<cell>.<region>.aws.neon.tech
VITE_NEON_AUTH_URL=https://<auth-endpoint>/neondb/auth

# Opsional: origin tambahan untuk CORS (pisahkan dengan koma).
APP_ORIGIN=
