# Nilai Neon di bawah ini diisi otomatis oleh `neon deploy` / `neon env pull`.
# Jangan commit nilai asli.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/db?sslmode=require
NEON_AUTH_BASE_URL=https://<auth-endpoint>/neondb/auth
NEON_AUTH_JWKS_URL=https://<auth-endpoint>/neondb/auth/.well-known/jwks.json
NEON_BRANCH=production
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=https://<branch>.storage.<cell>.<region>.aws.neon.tech
AWS_REGION=<region>

# Frontend (Vite) — publik, ikut ter-bundle saat build.
VITE_API_URL=https://<branch>-api.compute.<cell>.<region>.aws.neon.tech
VITE_NEON_AUTH_URL=https://<auth-endpoint>/neondb/auth
VITE_VAPID_PUBLIC_KEY=<vapid-public-key>

# Web Push (dipakai Function api & remind). Buat dengan `npx web-push generate-vapid-keys`.
VAPID_PUBLIC_KEY=<vapid-public-key>
VAPID_PRIVATE_KEY=<vapid-private-key>
VAPID_SUBJECT=mailto:admin@example.com

# Email pengingat harian (Function remind). Isi salah satu provider.
# Tanpa konfigurasi ini, email dilewati dan pengingat push tetap berjalan.
# Opsi 1: Resend (https://resend.com) — tanpa domain, `onboarding@resend.dev` hanya bisa ke email pemilik akun.
RESEND_API_KEY=
# Opsi 2: SMTP apa pun, mis. Gmail app password: smtps://user:app-password@smtp.gmail.com:465
SMTP_URL=
# Wajib bila email diaktifkan. Contoh: "Tenggat <appgurumam1@gmail.com>"
REMINDER_EMAIL_FROM=
# Tautan di dalam email.
APP_URL=https://ingatkansaya.vercel.app

# Opsional: origin tambahan untuk CORS (pisahkan dengan koma).
APP_ORIGIN=
